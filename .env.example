# ==================== 环境变量示例 ====================
# 复制为 .env 后按需修改；本地运行会自动加载项目根目录 .env（config_loader.load_dotenv），
# docker compose 也会自动读取。已存在的系统环境变量优先，.env 不会覆盖。
# 所有值均为可选：不配置则用 config/settings.yaml 中的默认值。

# ---- LLM（真实模型，OpenAI 兼容协议）----
# provider 留空则用 fake（无 Key 演示模式）
AGENT_LLM_PROVIDER=openai_compatible
AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_LLM_MODEL=qwen3.8-max
# 规划用快模型（可省，缺省用 AGENT_LLM_MODEL）
AGENT_LLM_PLAN_MODEL=qwen3.8-flash
# false=直连不走系统代理（推荐，避免代理劫持 LLM 延迟/失败）；true=走代理
AGENT_LLM_USE_PROXY=false
AGENT_LLM_API_KEY=sk-你的百炼APIKey

# ---- 记忆（hybrid = 短时内存 + 长时 Redis）----
AGENT_MEMORY_PROVIDER=hybrid
AGENT_REDIS_URL=redis://localhost:6379/0

# ---- API 鉴权（可选，客户环境开启）----
# AGENT_AUTH_ENABLED=true
# AGENT_AUTH_TOKEN=agent-fw-<随机长串>
# AGENT_AUTH_RATE_LIMIT=60

# ---- 白标化（可选，交付客户时配置）----
# AGENT_BRAND_APP_NAME=轻量智能 Agent 工具编排框架
# AGENT_BRAND_LOGO_TEXT=AGENT
# AGENT_BRAND_LOGO_SUFFIX=·控制台
# AGENT_BRAND_AGENT_LABEL=AGENT
# AGENT_BRAND_PRIMARY_COLOR=#4F8CFF
# AGENT_BRAND_ACCENT_COLOR=#22D3EE
